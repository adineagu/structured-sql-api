#parse("library.Query")
$ctx.require($ctx.kind($mapping) == "insert" && !$ctx.has($mapping.multiInsertTargets), "A single-target INSERT is required")
$ctx.require($ctx.kind($mapping.query) == "simple", "A simple outer SELECT is required")
$ctx.require(!$ctx.hasIntegrationSettings($mapping), "Dedicated integration fields are unsupported")
$ctx.require($mapping.annotations() && $mapping.annotations().all().size() == 1 && $mapping.annotations().has("LOAD"), "Exactly one root LOAD annotation is required")
#set($load = $mapping.annotations().get("LOAD"))
$ctx.require($load.attributes().size() == 1 && $load.attribute("MODE") == "APPEND", "LOAD requires MODE=APPEND and no other attributes")
#set($configured = $ctx.useDeclaredDatastoreNames())
$ctx.validate($mapping)
