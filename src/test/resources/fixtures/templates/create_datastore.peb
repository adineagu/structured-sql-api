{% set xtDatastoreName = "XT_" ~ datastore.name ~ "_V" %}
{% set stageDatastoreName = "ST_" ~ datastore.name %}
CREATE OR REPLACE DATASTORE TEST_STAGE.{{ stageDatastoreName }}

ALIAS {{ stageDatastoreName }}

RESOURCE '{{ stageDatastoreName }}'
(
   LOAD_ID NUMBER(22,0) NOT NULL
  ,EFFECTIVE_DATE DATE NOT NULL
{% for col in datastore.attributes %}
  ,{{ col.name | lower }}
  {% if col.annotations() is not null and col.annotations().has("PROPERTIES") and col.annotations().get("PROPERTIES").attribute("CHAR_LENGTH_SEMANTIC") == "CHAR" %}
    VARCHAR2_CHAR({{ col.length }})
  {% else %}
    {{ col.ddlDataType }}
  {% endif %}
  {% if col.isMandatory %} NOT NULL{% endif %}

{% endfor %}
);

{# Pebble supports filters like Jinja2 #}
-- Table: {{ xtDatastoreName | upper }}

-- Columns: {{ datastore.attributes | length }}
